#VRML_SIM R2025a utf8

EXTERNPROTO "../../../objects/floors/protos/Floor.proto"

WorldInfo {
  basicTimeStep 16
  title "Camera projection switch"
  info [
    "Switches Camera.projection while the simulation is running."
    "Regression for https://github.com/cyberbotics/webots/issues/6910."
  ]
}
Viewpoint {
  orientation 0 0 1 0
  position 0.4 0 1.6
}
DirectionalLight {
  direction 0.2 -0.4 -1
  intensity 2
}
Floor {
}
Robot {
  supervisor TRUE
  children [
    Camera {
      name "camera"
      translation 0 0 0.2
      fieldOfView 1.2
      width 160
      height 120
      projection "planar"
    }
  ]
  name "robot"
  controller "camera_projection_switch"
}
Solid {
  translation 1.2 0 0.25
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.9 0.1 0.1
        }
      }
      geometry Box {
        size 0.4 0.4 0.4
      }
    }
  ]
  name "red box"
}
Solid {
  translation 0.2 1.0 0.2
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.1 0.8 0.2
        }
      }
      geometry Box {
        size 0.3 0.3 0.3
      }
    }
  ]
  name "green box"
}
